{
  "manifest_version": 3,
  "name": "GoGo",
  "version": "1.0.0",
  "description": "Стартовая страница с вкладками из ваших закладок.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": ["bookmarks", "storage", "unlimitedStorage"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}